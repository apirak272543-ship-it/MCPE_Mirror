}
requires {
	glfw >= 3.3.7-1
	openal >= 1.21.1-5
}
global-writable-files {
      "settings/minecraftpe" directory keep-old
}
urls {
      "https://gitea.sffempire.ru/Kolyah35/minecraft-pe-0.6.1/"
}
